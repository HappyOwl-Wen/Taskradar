# --- Secrets & local configuration (never commit) ---
.env
.env.*
!.env.example
*client_secret*.json
credentials*.json
token*.json
*.pem
*.key

# --- Local application data ---
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3
logs/
*.log

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Frontend ---
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# --- Built frontend (vite build output, served by the backend) ---
backend/src/taskradar/static/

# --- Demo output generated at runtime (fixtures live in backend/tests/fixtures) ---
demo/generated/

# --- Local tools ---
.tools/

# --- Packaging ---
release/
*.spec.bak

# --- OS / editors ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
