# TaskRadar environment variables (all optional). Copy to `.env` next to this file to use them.
# Secrets do NOT belong here: the Google OAuth client and token are entered in the app and stored in the
# Windows Credential Manager. Never commit a `.env` file.

# Where the database and logs live (default: %LOCALAPPDATA%\TaskRadar).
# TASKRADAR_DATA_DIR=C:\Users\you\TaskRadarData

# HTTP port (default 8000). The server always binds to 127.0.0.1.
# TASKRADAR_PORT=8000

# Binding to anything other than loopback is refused unless this is set. Do not enable it on a laptop.
# TASKRADAR_HOST=127.0.0.1
# TASKRADAR_ALLOW_NON_LOOPBACK=0

# Development only: allow state-changing requests from the Vite dev server (see CONTRIBUTING.md).
# TASKRADAR_DEV_ORIGIN=http://127.0.0.1:5173

# Do not open the browser on start (browser version) / do not run background jobs (reminder checks, timer ends).
# TASKRADAR_NO_BROWSER=1
# TASKRADAR_DISABLE_SCHEDULER=1

# Log level: DEBUG, INFO, WARNING, ERROR (secrets are masked in any case).
# TASKRADAR_LOG_LEVEL=INFO
